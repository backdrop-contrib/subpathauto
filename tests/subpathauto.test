<?php
/**
 * @file
 * Test integration for the subpathauto.module.
 */

/**
 * @group subpathauto
 * @group path
 */
class SubPathautoUnitTestCase extends BackdropWebTestCase {
  function setUp() {
    parent::setUp(array('subpathauto'));

    $this->addAlias('node/1', 'content/first-node');
    $this->addAlias('node/1/test', 'content/first-node-test');
    $this->addAlias('admin', 'malicious-path');
  }

  /**
   * Test that sub-path aliases are created and returned correctly.
   */
  function testSubPathAliases() {
    $this->assertAlias('node/1', 'content/first-node');
    $this->assertAlias('node/1/a', 'content/first-node/a');
    $this->assertNoAlias('node/1/a/b');
    $this->assertAlias('node/1/test', 'content/first-node-test');
    $this->assertAlias('node/1/test/a', 'content/first-node-test/a');
    $this->assertNoAlias('node/1/test/a/b');

    // Change the depth to two-levels deep.
    config_set('subpathauto.settings', 'depth', 2);
    backdrop_static_reset();
    $this->assertAlias('node/1', 'content/first-node');
    $this->assertAlias('node/1/a', 'content/first-node/a');
    $this->assertAlias('node/1/a/b', 'content/first-node/a/b');
    $this->assertNoAlias('node/1/a/b/c');
    $this->assertAlias('node/1/test', 'content/first-node-test');
    $this->assertAlias('node/1/test/a/b', 'content/first-node-test/a/b');
    $this->assertNoAlias('node/1/test/a/b/c');

    // Test that admin paths should be excluded.
    backdrop_static_reset();
    $this->assertNoAlias('node/1/edit');
    $this->assertNoAlias('admin/modules');

    // Test with $options['alias'] and $options['external'].
    $this->assertNoAlias('node/1/a', array('alias' => TRUE));
    $this->assertAlias('node/1/a', 'content/first-node/a', array(
      'alias' => FALSE,
    ));
    $this->assertNoAlias('node/1/a', array('external' => TRUE));
    $this->assertAlias('node/1/a', 'content/first-node/a', array(
      'external' => FALSE,
    ));

    // Enable sub-path aliases for admin paths.
    config_set('subpathauto.settings', 'ignore_admin', 0);
    backdrop_static_reset();
    $this->assertAlias('node/1/edit', 'content/first-node/edit');
    $this->assertAlias('admin/modules', 'malicious-path/modules');
  }

  /**
   * Test that sub-path aliases are created and returned correctly for
   * language-specific paths.
   */
  function getPathAlias($path, $options = array()) {
    // Merge in defaults.
    $options += array(
      'fragment' => '',
      'query' => array(),
      'absolute' => FALSE,
      'alias' => FALSE,
      'prefix' => '',
    );

    if (!isset($options['external'])) {
      // Return an external link if $path contains an allowed absolute URL. Only
      // call the slow backdrop_strip_dangerous_protocols() if $path contains a
      // ':' before any / ? or #. Note: we could use url_is_external($path)
      // here, but that would require another function call, and performance
      // inside url() is critical.
      $colonpos = strpos($path, ':');
      $options['external'] = ($colonpos !== FALSE && !preg_match('![/?#]!', substr($path, 0, $colonpos)) && backdrop_strip_dangerous_protocols($path) == $path);
    }

    // Preserve the original path before altering or aliasing.
    $original_path = $path;

    // Allow other modules to alter the outbound URL and options.
    backdrop_alter('url_outbound', $path, $options, $original_path);

    if (isset($options['fragment']) && $options['fragment'] !== '') {
      $options['fragment'] = '#' . $options['fragment'];
    }

    if ($options['external']) {
      return $path;
    }

    global $base_url, $base_secure_url, $base_insecure_url;

    // The special path '<front>' links to the default front page.
    if ($path == '<front>') {
      $path = '';
    }
    elseif (!empty($path) && !$options['alias']) {
      $language = isset($options['language']) && isset($options['language']->language) ? $options['language']->language : '';
      $alias = backdrop_get_path_alias($original_path, $language);
      if ($alias != $original_path) {
        $path = $alias;
      }
    }

    return $path;
  }

  /**
   * Assert that the given source path has the expected alias.
   *
   * @param string $source
   *   The source path.
   * @param string $alias
   *   The expected alias.
   * @param array $options
   *   An array of options to pass to backdrop_get_path_alias().
   *
   * @return bool
   *   TRUE if the alias matches, FALSE otherwise.
   */
  function assertAlias($source, $alias, array $options = array()) {
    $actual_alias = $this->getPathAlias($source, $options);
    $actual_source = backdrop_get_normal_path($alias);
    $args = array(
      '@source' => $source,
      '@alias' => $alias,
      '@source-actual' => $actual_source,
      '@alias-actual' => $actual_alias,
    );
    return $this->assertIdentical($alias, $actual_alias, t("backdrop_get_path_alias('@source') was '@alias-actual' and expected '@alias'", $args))
        || $this->assertIdentical($source, $actual_source, t("backdrop_get_normal_path('@alias') was '@source-actual' and expected '@source'", $args));
  }

  /**
   * Assert that the given source path has no alias.
   *
   * @param string $source
   *   The source path.
   * @param array $options
   *   An array of options to pass to backdrop_get_path_alias().
   *
   * @return bool
   *   TRUE if the alias matches, FALSE otherwise.
   */
  function assertNoAlias($source, array $options = array()) {
    return $this->assertAlias($source, $source, $options);
  }

  /**
   * Add an alias to the path system.
   *
   * @param string $source
   *   The source path.
   * @param string $alias
   *   The alias path.
   * @param string $langcode
   *   The language code for the alias.
   */
  function addAlias($source, $alias, $langcode = LANGUAGE_NONE) {
    $alias = array(
      'source' => $source,
      'alias' => $alias,
      'language' => $langcode,
    );
    path_save($alias);
    backdrop_clear_path_cache();
  }
}
